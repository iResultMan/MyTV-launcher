    <!-- Phone and cloud (cloud link) -->
    <string name="cloud_title">Téléphone et cloud</string>
    <string name="cloud_intro">Contrôlez ce téléviseur depuis votre téléphone quand vous n\'êtes pas chez vous. Le téléviseur se connecte seulement vers le serveur ; rien ne se connecte vers lui et aucun port n\'est ouvert à la maison.</string>
    <string name="cloud_learns_title">Ce que le serveur apprend</string>
    <string name="cloud_learns">Le nom de ce téléviseur, les noms de paquet et les libellés des applications au premier plan et les heures où l\'écran était allumé, les derniers événements du journal et les messages que vous envoyez. Il n\'apprend ni le code des parents, ni le nom du Wi-Fi, ni ce que vous regardez. Les données de plus de 30 jours sont supprimées.</string>
    <string name="cloud_off_deletes">Désactiver le contrôle cloud supprime les données de ce téléviseur sur le serveur.</string>
