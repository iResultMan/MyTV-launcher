    <string name="cloud_title">טלפון וענן</string>
    <string name="cloud_intro">שלטו בטלוויזיה הזאת מהטלפון כשאתם לא בבית. הטלוויזיה רק מתחברת החוצה אל השרת; שום דבר לא מתחבר פנימה, ולא נפתח שום פורט בבית.</string>
    <string name="cloud_learns_title">מה השרת לומד</string>
    <string name="cloud_learns">את שם הטלוויזיה הזאת, את שמות החבילות ותוויות היישומים שמוצגים ואת השעות שבהן המסך היה דלוק, את האירועים האחרונים ביומן ואת ההודעות שאתם שולחים. הוא לא לומד את קוד ההורים, את שם ה-Wi-Fi או את מה שאתם צופים בו. נתונים בני יותר מ-30 יום נמחקים.</string>
